# Keep the real Telegram credentials out of version control -
# telegram_config.example.json (placeholders) is fine to commit, the
# real file with your bot token/chat ID is not.
telegram_config.json

# Same idea for Supabase - supabase_config.example.json (placeholders)
# is fine to commit, the real file with your project URL/key is not.
supabase_config.json

# Same idea again for hardware config - hardware_config.example.json
# (placeholders, defaults to fully simulated) is fine to commit, but
# the real file is machine-specific (COM port numbers differ per PC),
# so it's not committed either.
hardware_config.json

# The database holds real customer names and room numbers - keep it
# local only, never commit it. Same reasoning for any exported CSV.
data/*.db
*.csv

# Python
__pycache__/
*.pyc

# pytest's cache dir (tests/ - see requirements-dev.txt to run them)
.pytest_cache/

# PyInstaller build output - these are generated by rebuilding, and
# dist/ also contains local copies of the real config files (see
# above) that must never be committed either.
dist/
build/
*.spec

# Debug/preview images created while troubleshooting the exe icon.
*.png

