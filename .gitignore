# Keep the real Telegram credentials out of version control.
# telegram_config.example.json (the template with placeholder values)
# is fine to commit - only the real file with your actual token/chat
# ID is ignored here.
telegram_config.json

# The database holds real customer names and room numbers - keep it
# local only, never commit it.
data/*.db

# Python
__pycache__/
*.pyc

# PyInstaller build output - these are generated by rebuilding, and
# dist/ also contains local copies of telegram_config.json and the
# database (see above) that must never be committed either.
dist/
build/
*.spec

# Debug/preview images created while troubleshooting the exe icon.
*.png

